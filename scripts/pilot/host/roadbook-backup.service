# Nightly backup unit for the VPS host (phase 10 CP4, BRIEF §3D).
# Install: sudo cp roadbook-backup.{service,timer} /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now roadbook-backup.timer
# Runs backup-all.sh: every stamped instance -> age ciphertext in ~/backups
# (the host holds only the PUBLIC key; archives are unreadable where they
# are produced). The operator's machine pulls the ciphertext on its own
# schedule — see pull-backups.sh.
[Unit]
Description=Roadbook pilot nightly backup (all instances)
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
User=ubuntu
ExecStart=/home/ubuntu/roadbook/scripts/pilot/host/backup-all.sh
TimeoutStartSec=1800
